@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: lightgray;
            color: black;
        }

        .navbar {
            background-color: darkslategray;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: khaki;
        }

        .nav-search {
            display: flex;
            flex: 1;
            max-width: 600px;
            margin: 0 20px;
        }

            .nav-search input {
                width: 100%;
                padding: 8px 12px;
                border: none;
                border-radius: 4px 0 0 4px;
                outline: none;
            }

        .search-btn {
            background-color: darkkhaki;
            border: none;
            padding: 0 15px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
        }

            .search-btn:hover {
                opacity: 0.8;
            }

        .nav-cart {
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .cart-icon {
            font-size: 24px;
            margin-right: 5px;
        }

        #cart-count {
            background-color: darkgoldenrod;
            color: white;
            font-weight: bold;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 14px;
        }

        .container {
            display: flex;
            max-width: 1250px;
            margin: 20px auto;
            gap: 20px;
            padding: 0 15px;
        }

        .cart-left {
            flex: 3;
            background-color: white;
            padding: 20px;
            border-radius: 4px;
        }

            .cart-left h2 {
                font-size: 28px;
                font-weight: 500;
                margin-bottom: 10px;
            }

        hr {
            border: 0;
            height: 1px;
            background: gray;
            margin-bottom: 20px;
        }

        .cart-item {
            display: flex;
            border-bottom: 1px solid gray;
            padding: 15px 0;
            align-items: center;
        }

        .item-img img {
            width: 120px;
            height: 120px;
            object-fit: contain;
            margin-right: 20px;
        }

        .item-details {
            flex: 1;
        }

            .item-details h3 {
                font-size: 18px;
                font-weight: bold;
                margin-bottom: 5px;
            }

        .stock-status {
            color: green;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-qty {
            background-color: whitesmoke;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
        }

            .btn-qty:hover {
                opacity: 0.8;
            }

        .qty-val {
            font-weight: bold;
            min-width: 20px;
            text-align: center;
        }

        .item-price {
            font-size: 18px;
            font-weight: bold;
            text-align: right;
            min-width: 100px;
        }

        .cart-right {
            flex: 1;
        }

        .checkout-box {
            background-color: white;
            padding: 20px;
            border-radius: 4px;
        }

        .subtotal-text {
            font-size: 18px;
            margin-bottom: 15px;
        }

        .checkout-btn {
            width: 100%;
            background-color: darkkhaki;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            margin-top: 15px;
        }

            .checkout-btn:hover {
                opacity: 0.8;
            }

        .gift-option {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
        }
        .main-left-column {
            flex: 3;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .main-right-column {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .try-prime-box {
            background-color: white;
            padding: 15px;
            border-radius: 4px;
            border-left: 4px solid deepskyblue;
        }

        .prime-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .prime-logo {
            font-style: italic;
            font-weight: 900;
            color: deepskyblue;
            font-size: 20px;
        }

        .prime-tag {
            background-color: deepskyblue;
            color: white;
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 3px;
            font-weight: bold;
        }

        .prime-text {
            font-size: 13px;
            line-height: 1.4;
            color: gray;
            margin-bottom: 12px;
        }

        .prime-btn {
            width: 100%;
            background: transparent;
            border: 1px solid darkgray;
            padding: 8px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
        }

            .prime-btn:hover {
                opacity: 0.8;
            }

        .add-ons-box {
            background-color: white;
            padding: 15px;
            border-radius: 4px;
        }

            .add-ons-box h3 {
                font-size: 16px;
                font-weight: bold;
                margin-bottom: 12px;
            }

        .addon-item {
            display: flex;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid whitesmoke;
        }

            .addon-item:last-child {
                border-bottom: none;
            }

            .addon-item img {
                width: 60px;
                height: 60px;
                object-fit: contain;
                background: whitesmoke;
                padding: 4px;
                border-radius: 4px;
            }

        .addon-info {
            flex: 1;
        }

            .addon-info h4 {
                font-size: 13px;
                font-weight: bold;
                margin-bottom: 3px;
                line-height: 1.2;
            }

        .addon-rating {
            font-size: 11px;
            color: darkorange;
            margin-bottom: 4px;
        }

        .addon-price {
            font-size: 14px;
            font-weight: bold;
            color: darkred;
            margin-bottom: 6px;
        }

        .btn-add-addon {
            background-color: darkkhaki;
            border: 1px solid orange;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            cursor: pointer;
        }

            .btn-add-addon:hover {
                opacity: 0.8;
            }

        .your-items-section {
            background-color: white;
            padding: 20px;
            border-radius: 4px;
        }

        .tabs-header {
            display: flex;
            gap: 20px;
            margin-bottom: 10px;
        }

        .tab-title {
            font-size: 18px;
            font-weight: 500;
            color: gray;
            cursor: pointer;
            padding-bottom: 5px;
        }

            .tab-title.active {
                color: black;
                font-weight: bold;
                border-bottom: 2px solid orange;
            }


        .saved-items-list {
            display: flex;
            flex-direction: column;
            margin-top: 15px;
        }

        .saved-item-row {
            display: flex;
            border-bottom: 1px solid whitesmoke;
            padding: 15px 0;
            align-items: center;
        }

            .saved-item-row:last-child {
                border-bottom: none;
            }

            .saved-item-row .item-img img {
                width: 110px;
                height: 110px;
                object-fit: contain;
                margin-right: 20px;
            }

            .saved-item-row .item-details {
                flex: 1;
            }

                .saved-item-row .item-details h3 {
                    font-size: 16px;
                    font-weight: bold;
                    margin-bottom: 5px;
                    line-height: 1.3;
                }

        .saved-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-move-to-cart {
            background: transparent;
            border: 1px solid darkgray;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
        }

            .btn-move-to-cart:hover {
                opacity: 0.8;
            }

        .action-separator {
            color: lightgray;
            font-size: 12px;
        }

        .item-link-action {
            font-size: 12px;
            color: teal;
            text-decoration: none;
        }

            .item-link-action:hover {
                color: orangered;
                text-decoration: underline;
            }

        .saved-item-row .item-price {
            font-size: 18px;
            font-weight: bold;
            text-align: right;
            min-width: 90px;
            color: black;
        }

    </style>
    <script language="JavaScript" src="~/Scripts/MyJS/ShoppingCart.js"></script>
</head>
<body onload="updateMainCartTotal();">
    <header class="navbar">
        <div class="nav-logo">
            <span class="logo-text">umazon</span>
        </div>
        <div class="nav-search">
            <input type="text" placeholder="Tìm kiếm hàng hóa...">
            <button class="search-btn"><i class="fas fa-search"></i></button>
        </div>
        <div class="nav-cart">
            <i class="fas fa-shopping-cart cart-icon"></i>
            <span id="cart-count">3</span>
        </div>
    </header>

    <main class="container">

        <div class="main-left-column">

            <section class="cart-left">
                <h2>Shopping Cart</h2>
                <hr>

                <div class="cart-item" data-price="110.96">
                    <div class="item-img">
                        <img src="~/Content/img/img1.jpg" alt="Sản phẩm 1">
                    </div>
                    <div class="item-details">
                        <h3>Tommy Hilfiger Women's Leather Saddle Shoulder Bag</h3>
                        <p class="stock-status">In Stock</p>
                        <div class="quantity-controls">
                            <button class="btn-qty btn-minus"><i class="fas fa-minus"></i></button>
                            <span class="qty-val">1</span>
                            <button class="btn-qty btn-plus"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-price">
                        $<span class="item-subtotal">110.96</span>
                    </div>
                </div>

                <div class="cart-item" data-price="42.88">
                    <div class="item-img">
                        <img src="~/Content/img/img2.jpg" alt="Sản phẩm 2">
                    </div>
                    <div class="item-details">
                        <h3>HOMIBEAK Barefoot Shoes Wide Circuit Lace Up Retro Sneakers</h3>
                        <p class="stock-status">In Stock</p>
                        <div class="quantity-controls">
                            <button class="btn-qty btn-minus"><i class="fas fa-minus"></i></button>
                            <span class="qty-val">1</span>
                            <button class="btn-qty btn-plus"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-price">
                        $<span class="item-subtotal">42.88</span>
                    </div>
                </div>

                <div class="cart-item" data-price="25.99">
                    <div class="item-img">
                        <img src="~/Content/img/img3.jpg" alt="Sản phẩm 3">
                    </div>
                    <div class="item-details">
                        <h3>Men's Slip on Walking Shoes Tennis Running Sneakers</h3>
                        <p class="stock-status">In Stock</p>
                        <div class="quantity-controls">
                            <button class="btn-qty btn-minus"><i class="fas fa-minus"></i></button>
                            <span class="qty-val">1</span>
                            <button class="btn-qty btn-plus"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-price">
                        $<span class="item-subtotal">25.99</span>
                    </div>
                </div>
            </section>

            <section class="your-items-section">
                <div class="tabs-header">
                    <span class="tab-title">Saved for later</span>
                    <span class="tab-title active">Buy it again</span>
                </div>
                <hr>
                <div class="saved-items-list">
                    <div class="saved-item-row">
                        <div class="item-img">
                            <img src="~/Content/img/img4.jpg" alt="Saved 1">
                        </div>
                        <div class="item-details">
                            <h3>Minimalist Wooden Smart Watch</h3>
                            <p class="stock-status">In Stock</p>
                            <div class="saved-actions">
                                <button class="btn-move-to-cart">Move to Cart</button>
                                <span class="action-separator">|</span>
                                <a href="#" class="item-link-action">Delete</a>
                            </div>
                        </div>
                        <div class="item-price">
                            $<span>89.00</span>
                        </div>
                    </div>

                    <div class="saved-item-row">
                        <div class="item-img">
                            <img src="~/Content/img/img5.jpg" alt="Saved 2">
                        </div>
                        <div class="item-details">
                            <h3>Classic Unisex Sunglasses Retro Style</h3>
                            <p class="stock-status">In Stock</p>
                            <div class="saved-actions">
                                <button class="btn-move-to-cart">Move to Cart</button>
                                <span class="action-separator">|</span>
                                <a href="#" class="item-link-action">Delete</a>
                            </div>
                        </div>
                        <div class="item-price">
                            $<span>15.95</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="main-right-column">

            <aside class="checkout-box">
                <p class="subtotal-text">
                    Subtotal (<span id="total-items">3</span> items):
                    <strong class="total-price">$<span id="cart-total">179.83</span></strong>
                </p>
                <div class="gift-option">
                    <input type="checkbox" id="gift">
                    <label for="gift">This order contains a gift</label>
                </div>
                <button class="checkout-btn">Proceed to checkout</button>
            </aside>

            <div class="try-prime-box">
                <div class="prime-header">
                    <span class="prime-logo">prime</span>
                    <span class="prime-tag">Free Delivery</span>
                </div>
                <p class="prime-text">Enjoy fast, FREE delivery on millions of eligible items with Amazon Prime.</p>
                <button class="prime-btn">Try Prime Free for 30 Days</button>
            </div>

            <div class="add-ons-box">
                <h3>Popular add-ons</h3>

                <div class="addon-item">
                    <img src="~/Content/img/img6.jpg" alt="Addon 1">
                    <div class="addon-info">
                        <h4>Smart Fitness Tracker IP67</h4>
                        <div class="addon-rating"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i> (4,250)</div>
                        <p class="addon-price">$24.99</p>
                        <button class="btn-add-addon">Add to Cart</button>
                    </div>
                </div>

                <div class="addon-item">
                    <img src="~/Content/img/img7.jpg" alt="Addon 2">
                    <div class="addon-info">
                        <h4>Wireless Bluetooth Headphones Over-Ear</h4>
                        <div class="addon-rating"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i> (12,840)</div>                   
                        <p class="addon-price">$49.99</p>
                        <button class="btn-add-addon">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
